PORTAL_EXTERNAL_URL=http://localhost:18080
CPA_API_BASE_URL=http://localhost:8317
# 启用模型网关前，先确认 CPA 内部地址及公网入口切换方案
# PORTAL_GATEWAY_LISTEN_ADDR=:18318
# CPA_UPSTREAM_URL=http://host.docker.internal:8317
CPAMP_BASE_URL=http://host.docker.internal:18317
# x86_64 使用 portal-linux-amd64；ARM64 使用 portal-linux-arm64
PORTAL_BINARY=portal-linux-amd64
# 三个容器须加入同一 systemd slice；只读挂载该组进行套件资源统计
PORTAL_RESOURCE_CGROUP_PARENT=cliproxy.slice
PORTAL_RESOURCE_CGROUP_HOST_PATH=/sys/fs/cgroup/cliproxy.slice
# 可选：从宿主机采集器读取 ESXi CPU/内存；未配置时监测当前 Linux 主机
# PORTAL_HOST_METRICS_PATH=/data/esxi-metrics.json
