PORTAL_AGY_EMBEDDED=true
AGY_COMMAND=/opt/cliproxy-agy/bin/agy
# Diagnostic candidate only; native notification-triggered refresh is unverified.
# Keep false for production. Enabled candidates remain bound to the tested hash.
AGY_CATALOG_REFRESH_EXPERIMENTAL=false
AGY_HOME=/var/lib/cliproxy-agy
AGY_MAX_SESSIONS=3
AGY_CONTAINER_MEMORY_MB=1024
